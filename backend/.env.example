# UbiFleet — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs. Ne jamais commiter .env.

# ── Django ───────────────────────────────────────────────────────────
# Clé secrète (obligatoire en production), à générer une fois :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# False en production (True uniquement sur un poste de développement)
DEBUG=False
# Adresses par lesquelles on joint le serveur (IP du serveur, nom DNS…)
ALLOWED_HOSTS=192.168.2.10,localhost,127.0.0.1
# Origines du site (schéma + adresse), séparées par des virgules
CSRF_TRUSTED_ORIGINS=http://192.168.2.10
CORS_ALLOWED_ORIGINS=http://192.168.2.10

# ── HTTPS (quand un certificat est installé sur le serveur web) ──────
# Passer à True, puis remplacer http:// par https:// ci-dessus.
HTTPS=False
# HSTS : à n'activer qu'une fois HTTPS stable (ex. 31536000 = 1 an)
HSTS_SECONDS=0

# ── Premier administrateur (créé au démarrage s'il n'en existe aucun) ─
# Renseigner pour la première installation, puis retirer ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── PostgreSQL ───────────────────────────────────────────────────────
DB_NAME=ubifleet_db
DB_USER=ubifleet_user
# Mot de passe fort, propre à cette installation
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432

# ── Redis / Celery ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# Tentatives de connexion autorisées par adresse IP
THROTTLE_CONNEXION=10/min
